    def github_login(self):
        token = self.github_token.get().strip()
        if not token:
            messagebox.showerror("Error", "Token is required.")
            return
        try:
            resp = requests.get("https://api.github.com/user", headers={"Authorization": f"token {token}"}, timeout=15)
            if resp.status_code == 200:
                user = resp.json()
                self.token_status_label.config(text=T[self.lang]["token_status"] + f" Logged in as {user['login']}", fg=self.theme["success"])
                self.save_config()
                self.git_log("Logged in as " + user["login"])
                messagebox.showinfo("Success", f"Logged in as {user['login']}")
            else:
                self.token_status_label.config(text=T[self.lang]["token_status"] + " Login failed", fg=self.theme["danger"])
                messagebox.showerror("Error", f"Login failed: {resp.status_code}")
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def browse_local_repo(self):
        folder = filedialog.askdirectory()
        if folder:
            self.local_repo_path.set(folder)
            self.git_log(f"Local path: {folder}")

    def run_git_command(self, args, cwd=None):
        if cwd is None:
            cwd = self.local_repo_path.get().strip()
            if not cwd:
                self.git_log("Error: Local repo path not set.")
                return None
        try:
            result = subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True, timeout=60)
            if result.returncode == 0:
                self.git_log("> " + " ".join(args) + " → OK")
                if result.stdout:
                    self.git_log(result.stdout.strip()[:600])
                return result.stdout
            else:
                self.git_log("> " + " ".join(args) + " → ERROR")
                if result.stderr:
                    self.git_log(result.stderr.strip()[:400])
                return None
        except Exception as e:
            self.git_log(f"Exception: {e}")
            return None

    def git_commit(self):
        msg = self.commit_msg.get().strip()
        if not msg:
            messagebox.showerror("Error", "Commit message required.")
            return
        self.run_git_command(["add", "."])
        res = self.run_git_command(["commit", "-m", msg])
        messagebox.showinfo("Commit", "Done" if res is not None else "Failed")

    def git_push(self):
        branch = self.run_git_command(["rev-parse", "--abbrev-ref", "HEAD"])
        if branch:
            branch = branch.strip()
            res = self.run_git_command(["push", "-u", "origin", branch])
            if res is not None:
                messagebox.showinfo("Push", f"Pushed to {branch}")
                return
        for b in ("main", "master"):
            res = self.run_git_command(["push", "-u", "origin", b])
            if res is not None:
                messagebox.showinfo("Push", f"Pushed to {b}")
                return
        messagebox.showerror("Error", "Push failed")

    def git_pull(self):
        res = self.run_git_command(["pull"])
        messagebox.showinfo("Pull", "Done" if res is not None else "Failed")

    def quick_git_status(self):
        self.git_custom_command.set("git status")
        self.run_custom_git_command()

    def run_custom_git_command(self):
        cmd = self.git_custom_command.get().strip()
        if not cmd:
            return
        try:
            if cmd.lower().startswith("git "):
                args = shlex.split(cmd)[1:]
            else:
                args = shlex.split(cmd)
            self.run_git_command(args)
        except Exception as e:
            self.git_log(f"Invalid command: {e}")

    def git_log(self, msg):
        ts = datetime.now().strftime("%H:%M:%S")
        self.git_log_text.insert(tk.END, f"[{ts}] {msg}\n")
        self.git_log_text.see(tk.END)

