    def parse_tree_structure(self, tree_text):
        lines = tree_text.splitlines()
        result = []
        stack = []
        for line in lines:
            if not line.strip():
                continue
            cleaned = line
            for p in PATTERNS_50:
                cleaned = re.sub(p, "", cleaned)
            cleaned = cleaned.strip()
            if not cleaned:
                continue
            leading = len(line) - len(line.lstrip(" \t"))
            depth = max(0, leading // 2)
            name = cleaned.rstrip("/")
            while len(stack) > depth:
                stack.pop()
            stack = stack[:depth]
            stack.append(name)
            full_path = "/".join(stack)
            is_dir = cleaned.endswith("/") or "." not in name
            result.append((full_path + ("/" if is_dir else ""), is_dir))
        return result

    def parse_code_blocks(self, code_text, mode):
        """تشخیص بسیار قوی همه حالت‌ها + اعداد + کلمه دلخواه + your name is XXX :"""
        lines = code_text.splitlines()
        blocks = []
        current_file = None
        current_content = []

        ALL_PATTERNS = [
            # // 1.file.2 : path   یا   // file: path
            (re.compile(r'^//\s*(?:[\d.\-]*\s*)?(?:file|FILE|mahan|MAHAN)\s*(?:[\d.\-]*)?\s*[:：]\s*(.+?)\s*$', re.I), 1),
            # # file: path
            (re.compile(r'^#\s*(?:[\d.\-]*\s*)?(?:file|FILE)\s*(?:[\d.\-]*)?\s*[:：]\s*(.+?)\s*$', re.I), 1),
            # --- FILE: path ---
            (re.compile(r'^---\s*(?:[\d.\-]*\s*)?(?:FILE|file)\s*(?:[\d.\-]*)?\s*[:：]\s*(.+?)\s*---\s*$', re.I), 1),
            # file: path   یا  2.file.1: path
            (re.compile(r'^(?:[\d.\-]*\s*)?(?:file|FILE|mahan|MAHAN)\s*(?:[\d.\-]*)?\s*[:：]\s*(.+?)\s*$', re.I), 1),
            # your name is mahan : path   یا هر چیزی که به : ختم شود
            (re.compile(r'^.*?[:：]\s*([a-zA-Z0-9_\-./\\]+(?:\.[a-zA-Z0-9]{1,12})?)\s*$'), 1),
            # فقط مسیر تمیز
            (re.compile(r'^([a-zA-Z0-9_\-./\\]+(?:\.[a-zA-Z0-9]{1,12}))\s*$'), 1),
        ]

        mode_map = {
            "Comment: // file: ": [ALL_PATTERNS[0]],
            "Comment: # file: ": [ALL_PATTERNS[1]],
            "--- FILE: ---": [ALL_PATTERNS[2]],
            "Path on its own line": [ALL_PATTERNS[5]],
            "Custom Regex": [],
            "Auto Detect": ALL_PATTERNS,
        }

        if mode == "Custom Regex":
            try:
                pat = re.compile(self.custom_regex_entry.get().strip(), re.I)
                patterns = [(pat, 1)]
            except Exception as e:
                messagebox.showerror("Error", f"Invalid regex: {e}")
                return []
        else:
            patterns = mode_map.get(mode, ALL_PATTERNS)

        LANG_TAGS = {"css", "php", "js", "javascript", "html", "python", "py", "json", "xml", "txt", "md", "sql", "bash", "sh", "ts", "jsx", "tsx"}

        for line in lines:
            stripped = line.strip()
            if not stripped:
                if current_file is not None:
                    current_content.append(line)
                continue

            matched = False
            for pat, grp in patterns:
                m = pat.match(stripped)
                if m:
                    if current_file is not None:
                        content = "\n".join(current_content).strip()
                        if content and content.lower() not in LANG_TAGS:
                            blocks.append((current_file, content))
                    path = m.group(grp).strip().strip("'\"")
                    path = re.sub(r"[\\/]+", "/", path).lstrip("./")
                    current_file = path
                    current_content = []
                    matched = True
                    break

            if not matched:
                if stripped.lower() in LANG_TAGS and current_file is not None and not current_content:
                    continue
                if current_file is not None:
                    current_content.append(line)

        if current_file is not None:
            content = "\n".join(current_content).strip()
            if content and content.lower() not in LANG_TAGS:
                blocks.append((current_file, content))
        return blocks

    def preview_code_injector(self):
        target = self.target_dir_injector.get()
        if not target:
            messagebox.showerror("Error", "Target folder not selected.")
            return
        tree_text = self.txt_tree.get("1.0", tk.END).strip()
        code_text = self.txt_code.get("1.0", tk.END).strip()
        if not tree_text and not code_text:
            messagebox.showerror("Error", "Nothing to preview.")
            return

        mode = self.injector_mode.get()
        tree_items = self.parse_tree_structure(tree_text) if tree_text and mode != "Code Only" else []
        code_blocks = self.parse_code_blocks(code_text, self.detection_mode.get()) if code_text and mode != "Tree Only" else []

        files_to_create = []
        for path, is_dir in tree_items:
            if not is_dir:
                files_to_create.append((path, ""))
        for fp, content in code_blocks:
            files_to_create = [f for f in files_to_create if f[0] != fp]
            files_to_create.append((fp, content))

        if not files_to_create:
            messagebox.showinfo("Preview", "No files detected.")
            return
        self.preview_and_confirm(files_to_create, target)

    def preview_and_confirm(self, parsed_files, target_dir):
        approved = []
        rejected = []
        idx = [0]

        win = tk.Toplevel(self.root)
        win.title("Preview & Confirm")
        win.geometry("900x650")
        win.configure(bg=self.theme["bg"])

        progress = tk.StringVar()
        tk.Label(win, textvariable=progress, bg=self.theme["bg"], fg=self.theme["primary"], font=("Segoe UI", 10, "bold")).pack(pady=5)
        path_var = tk.StringVar()
        tk.Label(win, textvariable=path_var, bg=self.theme["bg"], fg=self.theme["fg"], font=("Consolas", 10, "bold")).pack(pady=3)

        txt = scrolledtext.ScrolledText(win, bg=self.theme["input"], fg=self.theme["fg"], font=("Consolas", 9), height=28, bd=0, insertbackground=self.theme["fg"])
        txt.pack(fill=tk.BOTH, expand=True, padx=12, pady=5)
        add_context_menu(txt, self.lang)
        enable_mouse_scroll(txt)

        def update():
            if idx[0] >= len(parsed_files):
                return
            fp, content = parsed_files[idx[0]]
            progress.set(f"File {idx[0]+1} / {len(parsed_files)}")
            path_var.set(fp)
            txt.delete("1.0", tk.END)
            txt.insert(tk.END, content if content else "(empty file)")

        def approve():
            if idx[0] < len(parsed_files):
                content = txt.get("1.0", tk.END).rstrip("\n")
                approved.append((parsed_files[idx[0]][0], content))
                idx[0] += 1
                if idx[0] < len(parsed_files):
                    update()
                else:
                    finish()

        def reject():
            if idx[0] < len(parsed_files):
                rejected.append(parsed_files[idx[0]][0])
                idx[0] += 1
                if idx[0] < len(parsed_files):
                    update()
                else:
                    finish()

        def finish():
            created = skipped = 0
            errors = []
            ow = self.overwrite_mode.get()
            for fp, content in approved:
                full = os.path.join(target_dir, fp)
                try:
                    if os.path.exists(full):
                        if ow == "No (Skip existing)":
                            skipped += 1
                            continue
                        if ow == "Ask" and not messagebox.askyesno("Overwrite?", f"Overwrite?\n{fp}"):
                            skipped += 1
                            continue
                    os.makedirs(os.path.dirname(full) or full, exist_ok=True)
                    with open(full, "w", encoding="utf-8") as f:
                        f.write(content)
                    created += 1
                except Exception as e:
                    errors.append(str(e))
            msg = f"Created: {created}"
            if skipped:
                msg += f"\nSkipped: {skipped}"
            if rejected:
                msg += f"\nRejected: {len(rejected)}"
            if errors:
                msg += f"\nErrors: {len(errors)}"
            messagebox.showinfo("Done", msg)
            self.log(msg)
            win.destroy()

        bf = tk.Frame(win, bg=self.theme["bg"])
        bf.pack(pady=10)
        tk.Button(bf, text="✅ Approve", bg=self.theme["success"], fg=self.theme["bg"], font=("Segoe UI", 10, "bold"),
                  bd=0, padx=15, pady=6, command=approve).pack(side=tk.LEFT, padx=5)
        tk.Button(bf, text="❌ Reject", bg=self.theme["danger"], fg=self.theme["bg"], font=("Segoe UI", 10, "bold"),
                  bd=0, padx=15, pady=6, command=reject).pack(side=tk.LEFT, padx=5)
        tk.Button(bf, text="Cancel", bg=self.theme["warning"], fg=self.theme["bg"], font=("Segoe UI", 10, "bold"),
                  bd=0, padx=15, pady=6, command=win.destroy).pack(side=tk.LEFT, padx=5)

        update()
        win.transient(self.root)
        win.grab_set()
        self.root.wait_window(win)

    def generate_files_from_code(self):
        self.preview_code_injector()

    # ================= PROMPT =================
    def init_prompt(self):
        f = self.frames["prompt"]
        self.txt_prompt = scrolledtext.ScrolledText(f, bg=self.theme["input"], fg=self.theme["fg"],
                                                    font=("Consolas", 10), bd=0, insertbackground=self.theme["fg"])
        self.txt_prompt.pack(fill=tk.BOTH, expand=True, padx=12, pady=6)
        enable_mouse_scroll(self.txt_prompt)
        add_context_menu(self.txt_prompt, self.lang)

        prompts = {
            "English": [
                """You are generating a complete project for the AFAR Code Injector.

STRICT RULES:
1. First output the folder tree:
project/
├── file1.ext
└── folder/
    └── file2.ext

2. Then every file must use exactly this separator:

// file: relative/path/to/file.ext
<complete content – no language tag after the separator>

3. Never put css / php / js on its own line after // file:
4. Full working code only.
""",
                """Generate a complete WordPress theme.
Use tree + // file: path format only.
No language tags after the separator line."""
            ],
            "فارسی": [
                """یک پروژه کامل برای AFAR Code Injector تولید کن.

قوانین اجباری:
۱. اول درخت پوشه‌ها را بده
۲. بعد هر فایل را دقیقاً با این جداکننده بنویس:

// file: مسیر/نسبی/فایل.ext
محتوای کامل فایل

۳. هرگز بعد از // file: خط زبانی مثل css یا php نگذار.
۴. کد کامل و قابل اجرا باشد.
""",
                """یک قالب کامل وردپرس بساز.
فقط از درخت + // file: path استفاده کن."""
            ]
        }

        lang_frame = tk.Frame(f, bg=self.theme["bg"])
        lang_frame.pack(fill=tk.X, padx=12, pady=6)
        tk.Label(lang_frame, text=T[self.lang]["prompt_lang"], bg=self.theme["bg"], fg=self.theme["fg"]).pack(side=tk.LEFT)
        prompt_lang = tk.StringVar(value="English")
        ttk.Combobox(lang_frame, textvariable=prompt_lang, values=["English", "فارسی"], state="readonly", width=10).pack(side=tk.LEFT, padx=5)

        def load():
            self.txt_prompt.delete("1.0", tk.END)
            for p in prompts[prompt_lang.get()]:
                self.txt_prompt.insert(tk.END, p + "\n\n" + "-" * 50 + "\n\n")
        tk.Button(lang_frame, text=T[self.lang]["load_prompts"], bg=self.theme["info"], fg=self.theme["bg"], command=load).pack(side=tk.LEFT, padx=10)

    # ================= HELP / EXPORT / SETTINGS (minimal working) =================
    def init_help(self):
        f = self.frames["help"]
        txt = scrolledtext.ScrolledText(f, bg=self.theme["input"], fg=self.theme["fg"], font=("Consolas", 10), bd=0)
        txt.pack(fill=tk.BOTH, expand=True, padx=12, pady=12)
        txt.insert(tk.END, T[self.lang]["help_text"] + "\n\n" + T[self.lang]["help_tips"])
        txt.config(state="disabled")
        add_context_menu(txt, self.lang)

    def init_export(self):
        f = self.frames["export"]
        p = tk.LabelFrame(f, text=T[self.lang]["export_title"], bg=self.theme["panel"], fg=self.theme["primary"],
                          font=("Segoe UI", 10, "bold"), bd=1, relief=tk.SOLID)
        p.pack(fill=tk.BOTH, expand=True, padx=20, pady=20)
        tk.Label(p, text=T[self.lang]["save_as"], bg=self.theme["panel"], fg=self.theme["fg"]).pack(anchor=tk.W, padx=20, pady=10)
        e = tk.Entry(p, textvariable=self.save_name, bg=self.theme["input"], fg=self.theme["fg"], font=("Consolas", 10), insertbackground=self.theme["fg"])
        e.pack(fill=tk.X, padx=20, pady=5)
        add_context_menu(e, self.lang)
        tk.Button(p, text=T[self.lang]["save_btn"], bg=self.theme["success"], fg=self.theme["bg"],
                  font=("Segoe UI", 10, "bold"), bd=0, padx=15, pady=6, command=self.save_output).pack(pady=10)

    def save_output(self):
        content = self.txt_out.get("1.0", tk.END).strip() if hasattr(self, "txt_out") else ""
        if not content:
            messagebox.showwarning("Warning", "No output.")
            return
        fname = self.save_name.get().strip() or "output.txt"
        target = self.reverse_dir.get() or self.target_dir.get() or os.getcwd()
        full = os.path.join(target, fname)
        try:
            with open(full, "w", encoding="utf-8") as f:
                f.write(content)
            messagebox.showinfo("Saved", full)
        except Exception as e:
            messagebox.showerror("Error", str(e))

    def init_settings(self):
        f = self.frames["settings"]
        left = tk.LabelFrame(f, text=T[self.lang]["settings_title"], bg=self.theme["panel"],
                             fg=self.theme["primary"], font=("Segoe UI", 10, "bold"), bd=1, relief=tk.SOLID)
        left.pack(side=tk.LEFT, fill=tk.Y, padx=20, pady=20, ipadx=15, ipady=15)
        tk.Label(left, text=T[self.lang]["lang"], bg=self.theme["panel"], fg=self.theme["fg"]).pack(anchor=tk.W, padx=10, pady=5)
        lc = ttk.Combobox(left, values=["English", "فارسی"], state="readonly")
        lc.set("English" if self.lang == "en" else "فارسی")
        lc.pack(fill=tk.X, padx=10, pady=5)
        lc.bind("<<ComboboxSelected>>", lambda e: self.set_lang(lc.get()))
        tk.Button(left, text=T[self.lang]["save_settings"], bg=self.theme["success"], fg="white",
                  font=("Segoe UI", 10, "bold"), bd=0, padx=15, pady=6, command=self.save_config_and_notify).pack(pady=15)

    def set_lang(self, val):
        self.lang = "en" if val == "English" else "fa"
        self.save_config()
        self.refresh_ui()

    def change_lang(self, e=None):
        self.lang = "en" if self.lang_cb.get() == "English" else "fa"
        self.save_config()
        self.refresh_ui()

    def update_status_lang(self):
        if hasattr(self, "status_bar"):
            self.status_bar.config(text=T[self.lang]["ready"])

    def create_status_bar(self):
        self.status_bar = tk.Label(self.root, text=T[self.lang]["ready"], bg=self.theme["panel"],
                                   fg="#94a3b8", anchor=tk.W, font=("Segoe UI", 9), padx=10)
        self.status_bar.pack(side=tk.BOTTOM, fill=tk.X)

    def create_log(self):
        f = tk.LabelFrame(self.root, text="📋 Live Log", bg=self.theme["panel"], fg=self.theme["warning"],
                          font=("Segoe UI", 9, "bold"), bd=1, relief=tk.SOLID)
        f.pack(side=tk.BOTTOM, fill=tk.X, padx=8, pady=(0, 6))
        self.txt_log = scrolledtext.ScrolledText(f, bg="#020617", fg=self.theme["warning"],
                                                 font=("Consolas", 9), height=4, bd=0, insertbackground=self.theme["fg"])
        self.txt_log.pack(fill=tk.BOTH, expand=True, padx=4, pady=4)
        enable_mouse_scroll(self.txt_log)
        add_context_menu(self.txt_log, self.lang)

    def log(self, msg):
        ts = datetime.now().strftime("%H:%M:%S")
        self.txt_log.insert(tk.END, f"[{ts}] {msg}\n")
        self.txt_log.see(tk.END)

    def copy_to_clip(self, widget):
        self.root.clipboard_clear()
        self.root.clipboard_append(widget.get("1.0", tk.END).strip())
        self.log("Copied to clipboard")

    def save_config_and_notify(self):
        self.save_config()
        messagebox.showinfo("Saved", "Settings saved.")


if __name__ == "__main__":
